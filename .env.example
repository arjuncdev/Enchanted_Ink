# Enchanted Ink — AI Whiteboard Configuration
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BOARD_MODEL=gemini-3.1-flash-lite
GEMINI_BOARD_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_HWR_MODEL=gemini-3.1-flash-lite
GEMINI_HWR_TIMEOUT_SECONDS=20

# Response provider: "gemini" or "ollama". Ollama runs locally at this URL by default.
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Local TrOCR checkpoint retained for optional local inference and research.
# Set absolute paths or paths relative to the project directory.
TROCR_CHECKPOINT=./stylus-model/stylus-finetuned
TROCR_CALIBRATION=./stylus-model/stylus-finetuned/calibration.json
# Use Microsoft's pretrained handwritten checkpoint if the project checkpoint is unavailable.
TROCR_ALLOW_BASELINE_FALLBACK=true
TROCR_BASELINE_MODEL=microsoft/trocr-small-handwritten
TROCR_DEVICE=cpu
HTR_ACCEPTANCE_THRESHOLD=0.72
HTR_INACTIVITY_MS=12000
