# Enchanted Ink — AI Whiteboard Configuration
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DIARY_MODEL=gemini-3.8-flash
GEMINI_BOARD_MODEL=gemini-3.8-flash

# Local fine-tuned model has priority when present. Model artifacts stay outside Git.
# Set absolute paths or paths relative to the project directory.
TROCR_CHECKPOINT=./models/trocr-iam
TROCR_CALIBRATION=./models/trocr-iam/calibration.json
# If the custom checkpoint is absent or cannot load, use the upstream IAM-trained model.
TROCR_ALLOW_BASELINE_FALLBACK=true
TROCR_BASELINE_MODEL=microsoft/trocr-small-handwritten
TROCR_DEVICE=cpu
HTR_ACCEPTANCE_THRESHOLD=0.72
HTR_INACTIVITY_MS=2200
